# Reproducible text line endings across Windows and Linux
* text=auto
*.csv text eol=lf
*.gmt text eol=lf
*.html text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.tsv text eol=lf
*.txt text eol=lf

# Binary scientific inputs
*.gz binary
*.tar binary
*.xlsx binary

